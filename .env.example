# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Dominio público del sitio (sin / al final)
NEXT_PUBLIC_SITE_URL=https://starshine.com.co

# Envío del formulario de Administración de personal (https://resend.com)
RESEND_API_KEY=
# Correo que recibe los mensajes
CONTACT_TO_EMAIL=starshinesas07@gmail.com
# Remitente verificado en Resend (ej. web@tudominio.com)
CONTACT_FROM_EMAIL=
